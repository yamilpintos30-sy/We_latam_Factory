# Crea claves nuevas y nunca las publiques ni las subas al repositorio.
OLLAMA_API_KEY=
ELEVENLABS_API_KEY=

# Endpoints (podés cambiarlos si migrás de proveedor).
OLLAMA_BASE_URL=https://ollama.com
ELEVENLABS_BASE_URL=https://api.elevenlabs.io

# Modelos (mantenelos en variables para poder rotarlos sin tocar código).
OLLAMA_MODEL=gpt-oss:120b
ELEVENLABS_MODEL=music_v2
COVER_MODEL=stabilityai/sd-turbo

PORT=3000
# Usa 0.0.0.0 para permitir acceso desde Tailscale/LAN.
HOST=0.0.0.0
COVER_DEVICE=cpu
GENERATION_CONCURRENCY=2
